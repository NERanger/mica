#!/usr/bin/env bash
set -euo pipefail
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
export PATH="$ROOT/.tools/bin:$PATH"
cd "$ROOT"

./scripts/generate

cmake -S . -B build -DCMAKE_BUILD_TYPE=Release
cmake --build build --parallel

mkdir -p build/bin
go build -o build/bin/planner ./examples/demo/planner
go build -o build/bin/mica-go-harness ./tests/harness/go

echo "build ok"
